                "properties": {
                  "confirm": {
                    "type": "string",
                    "enum": [
                      "RESET"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "seeded": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/seed/stats": {
      "get": {
        "summary": "Seed info",
        "description": "DB counts and taxonomy depth. Optional `root` scopes counts to that subtree. No seed-domain metadata.",
